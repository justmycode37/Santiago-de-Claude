  js += `    tl.fromTo("#act5-phh", { opacity: 0, y: 120, scale: 1.0, transformOrigin: "50% 50%" }, { opacity: 1, y: 0, scale: 1.1, duration: 0.55, ease: "expo.out" }, ${l(t5.H)});
    up("#act5-h0", ${r3(l(a(9).start) - 0.05)}, 50, 0.4);
