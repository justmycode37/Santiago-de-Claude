    <video id="act5-i3" class="clip act5-row" style="top: 640px" data-start="${r3(l(a(17).start) - 0.1)}" data-duration="${r3(t5.M - a(17).start + 0.1)}" data-track-index="1" src="assets/i3v.mp4" muted playsinline></video>`;
  [["i1", 15], ["i2", 16], ["i3", 17]].forEach(([f, i]) => {
