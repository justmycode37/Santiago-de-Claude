    hide(["#act5-phj", "#act5-j0", "#act5-j1", "#act5-j2"], ${l(t5.K)});\n`;
  // K — the map fills up, full frame
  const K = closeup(id, "K", "mK.mp4", l(t5.K), l(t5.L), [[l(a(14).start), "Everything you need.", "navy"]], "50% 50%", 1.1);
  html += K.html; js += K.js;
