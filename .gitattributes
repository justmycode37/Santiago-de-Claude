# RightSide (native iOS) is built on a Mac: keep its text files LF on every checkout.
rightside/** text=auto eol=lf
rightside/**/*.bin binary
rightside/**/*.mlmodel binary
rightside/**/*.png binary
rightside/**/*.jpg binary
*.onnx binary
# Generated place tiles (tools/build-map-places.mts): no line-ending conversion, no text diffs
map-places/** -text -diff linguist-generated=true
