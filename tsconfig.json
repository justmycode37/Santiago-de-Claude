{
  // The scripts the app's page runs (src/). Most are plain scripts, not modules: what a file declares at its top
  // level is global, as it is in the browser. Types are only checked here; scripts/build.mts makes the .js.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable", "webworker.importscripts"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    // maplibre-gl comes from its CDN as a plain script (index.html): its global maplibregl
    "allowUmdGlobalAccess": true,
    "types": [],
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  // the other pages' scripts have their own tsconfig.json: each is checked on its own
  "exclude": ["src/pages"]
}
