[Unit]
Description=Deploy the Kante engine if main has changed
After=network-online.target
Wants=network-online.target

[Service]
# The builds run here: if memory runs out, the kernel kills a build, not the engine that serves
OOMScoreAdjust=900
Type=oneshot
ExecStart=%h/kante-host/repo/deploy/deploy.sh
Nice=10
TimeoutStartSec=45min
