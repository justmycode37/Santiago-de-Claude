{
  // The scripts of the pages beside the app (the scan bench, the 3D station page, the demo pages). Each page is its
  // own world, so every file is checked on its own ("moduleDetection": "force"): what one declares at its top
  // level, the others do not see. What they import is checked with them; the globals come from ../types and
  // ../translate.ts (APP_LANG, which the page's modules read).
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "moduleDetection": "force"
  },
  "include": ["*.ts", "../types", "../translate.ts"],
  "exclude": []
}
